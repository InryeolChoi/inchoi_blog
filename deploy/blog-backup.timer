# /etc/systemd/system/blog-backup.timer
[Unit]
Description=blog.db 백업을 하루 한 번

[Timer]
# UTC 03:20 = 한국 시간 정오 무렵. 글을 쓸 만한 시간대를 피한 것이 아니라,
# **어차피 서버를 멈추지 않으므로 시각은 중요하지 않다.** 다른 timer(apt,
# e2scrub)와 겹치지 않게만 잡았다.
OnCalendar=*-*-* 03:20:00 UTC
RandomizedDelaySec=15m

# **꺼져 있던 동안 놓친 실행을 켜지자마자 한 번 돌린다.** 인스턴스를 며칠
# 내렸다 올리면 그 사이 백업이 통째로 비는데, 그걸 사람이 알아채기 어렵다.
Persistent=true

[Install]
WantedBy=timers.target
