# /etc/systemd/system/blog.service
#
# 배포물은 바이너리 하나와 SQLite 파일 하나다. 앞에 Caddy가 하나 서 있고
# (HTTPS와 인증서), 그 뒤는 예전 그대로다 — 컨테이너도 런타임도 없다.
[Unit]
Description=열렬히.뛰기 (blog)
Documentation=https://github.com/inryeol/blog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blog
Group=blog

# admin 로그인 설정(GitHub client id/secret, 허용 계정, 세션 키)이 여기 있다.
# **저장소에 없고 인스턴스에만 있다.** client secret을 유닛 파일에 적으면
# systemctl show로 아무나 읽을 수 있고 저장소에도 남는다.
#
# 앞의 "-"는 파일이 없어도 서비스가 뜨라는 뜻이다. 없으면 BLOG_ADMIN_FLAG가
# 비어서 admin이 그냥 안 열린다 — 모자란 설정으로 반쯤 열리는 것보다 낫다.
EnvironmentFile=-/etc/blog/admin.env

# -drafts는 **절대 붙이지 않는다.** 작성 중인 글 366편이 그대로 공개된다.
#
# -admin은 /etc/blog/admin.env의 BLOG_ADMIN_FLAG로 켠다. 여기 직접 적지
# 않는 이유는 그 파일이 있어야만(=client id/secret/허용 계정이 갖춰져야만)
# 켜지게 하려는 것이다. 설정이 모자란 채로 -admin을 주면 서버가 아예
# 안 뜨고(cmd/blog의 adminAuth), 그러면 admin이 아니라 사이트가 죽는다.
#
# **$BLOG_ADMIN_FLAG는 중괄호 없이 쓴다.** systemd는 ${VAR}는 한 덩어리로,
# $VAR는 공백으로 쪼개서 넘긴다. 비어 있을 때 빈 인자 하나가 남지 않아야 한다.
#
# -addr는 loopback이다. **밖에서 이 포트에 직접 닿을 수 없다.** 방화벽에
# 8080 규칙이 없어서가 아니라, 소켓 자체가 127.0.0.1에만 붙기 때문이다.
ExecStart=/opt/blog/blog -db /var/lib/blog/blog.db -addr 127.0.0.1:8080 $BLOG_ADMIN_FLAG

Restart=always
RestartSec=2s

# 80번을 Caddy가 가져갔으므로 특권 포트에 붙을 일이 없다. 능력을 통째로 비운다.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# 파일시스템은 DB가 있는 곳만 쓸 수 있다. 마이그레이션과 SQLite 저널이
# 쓰기를 하므로 디렉토리째 열어야 한다(파일 하나만으로는 저널을 못 만든다).
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blog
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_UNIX까지 여는 이유: 막아두면 표준 라이브러리가 소켓을 여는
# 어느 경로에서 조용히 실패할 때 원인을 찾기가 아주 어렵다.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

# 1GB짜리 기계다. 여기서 새면 SSH까지 같이 죽는다. Caddy 몫(192M)을
# 남겨둔 값이다.
MemoryHigh=384M
MemoryMax=512M

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
