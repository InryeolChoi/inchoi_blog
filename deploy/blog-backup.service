# /etc/systemd/system/blog-backup.service
#
# blog-backup.timer가 부른다. 사람이 직접 부를 수도 있다:
#   sudo systemctl start blog-backup
[Unit]
Description=blog.db 백업 (VACUUM INTO + gzip)
Documentation=file:///opt/blog/backup-db.sh
# **blog가 떠 있지 않아도 돈다.** 백업은 서버와 무관하게 파일만 보면 된다.
# 오히려 서버가 죽어 있을 때야말로 백업이 있어야 하는 상황이다.

[Service]
Type=oneshot
ExecStart=/opt/blog/backup-db.sh

# root로 돈다. 안에서 sqlite3만 blog 사용자로 내려 실행한다 —
# 결과 파일 소유가 어긋나지 않게 하려는 것이다.
User=root

# 1GB짜리 기계다. gzip이 79MB를 훑는 동안 사이트가 느려지면 안 된다.
Nice=10
IOSchedulingClass=idle
MemoryMax=128M

StandardOutput=journal
StandardError=journal
