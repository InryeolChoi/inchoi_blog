# /etc/caddy/Caddyfile
#
# **이 저장소가 정본이다.** 인스턴스에서 손으로 고치면 다음 setup-caddy.sh와
# 갈라진다 — 고칠 일이 있으면 여기서 고치고 스크립트를 다시 돌린다.
#
# 하는 일은 하나다: 밖에서 온 443을 받아 127.0.0.1:8080의 blog에 넘긴다.
# 인증서는 Caddy가 Let's Encrypt에서 알아서 받고 알아서 갱신한다.

inquieto.dev {
	# **www는 넣지 않는다.** www.inquieto.dev는 지금 Porkbun 파킹
	# (pixie.porkbun.com)을 가리킨다. 여기 적으면 그 이름으로도 인증서를
	# 받으려 드는데 HTTP-01 검증이 우리 기계로 오지 않아 실패하고, 실패한
	# 이름 하나가 발급 전체를 막는다. www를 쓰려면 DNS A 레코드를 먼저
	# 35.230.119.252로 옮기고 그 다음 여기 추가한다.

	reverse_proxy 127.0.0.1:8080

	# Caddy가 X-Forwarded-Proto: https를 붙여준다. admin의 secure()가 그걸
	# 보고 세션 쿠키에 Secure를 켠다(internal/admin/auth.go). **이 헤더가
	# 없으면 쿠키가 평문에서도 오간다** — reverse_proxy 기본값이라 따로
	# 적지 않지만, 프록시를 바꿀 일이 생기면 이게 조건이다.

	encode zstd gzip

	header {
		# HTTPS로만 오게 한다. 세션 쿠키가 생긴 뒤로는 다운그레이드가
		# 곧 쿠키 도난 경로다.
		#
		# **includeSubDomains와 preload는 일부러 뺐다.** 서브도메인을
		# 나중에 HTTP로 쓸 여지를 남기고, preload는 목록에 올라가면
		# 되돌리는 데 몇 달이 걸린다. 되돌려야 하면 max-age=0으로 바꿔
		# 배포하고 브라우저들이 그 값을 받아갈 때까지 기다린다.
		Strict-Transport-Security "max-age=31536000"

		# 우리가 보낸 Content-Type을 브라우저가 제 맘대로 다시 추측하지
		# 않게 한다. /img/{sha256}가 DB의 mime을 그대로 내보내는 자리다.
		X-Content-Type-Options "nosniff"

		# admin에 로그아웃·저장 버튼이 있다. 남의 페이지가 우리를 투명하게
		# 겹쳐놓고 클릭을 가로채는 것을 막는다.
		X-Frame-Options "SAMEORIGIN"

		# 본문의 유튜브 임베드가 쓰는 값과 같다. **no-referrer로 아주 끊으면
		# 안 된다** — 유튜브 임베드가 "오류 153"으로 재생을 거부한다.
		# (iframe의 referrerpolicy 속성이 이겨서 실제로는 안 깨지지만,
		#  문서 기본값도 같은 값으로 맞춰 둔다.)
		Referrer-Policy "strict-origin-when-cross-origin"

		# 서버 종류를 굳이 알리지 않는다.
		-Server
	}
}
